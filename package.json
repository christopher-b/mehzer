{
	"name": "mehzur",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"build:node": "vite build",
		"db:generate": "drizzle-kit generate",
		"start": "node build",
		"test": "vitest run",
		"test:coverage": "vitest run --coverage",
		"test:watch": "vitest",
		"test:e2e": "playwright test --project=setup --project=auth --project=desktop --project=phone",
		"test:e2e:report": "playwright show-report",
		"check:e2e": "tsc -p tests/e2e/tsconfig.json",
		"test:e2e:safari": "playwright test --project=setup-safari --project=safari --project=iphone",
		"test:e2e:all": "playwright test"
	},
	"devDependencies": {
		"@playwright/test": "^1.64.1",
		"@sveltejs/adapter-node": "^6.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@types/better-sqlite3": "^9.6.0",
		"@types/nodemailer": "^8.0.2",
		"@vitest/coverage-v8": "^5.0.5",
		"drizzle-kit": "^0.31.11",
		"svelte": "^5.57.1",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"vite": "^8.3.0",
		"vitest": "^5.0.5"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"dependencies": {
		"@lucide/svelte": "^1.61.0",
		"@simplewebauthn/browser": "^14.0.0",
		"@simplewebauthn/server": "^14.0.3",
		"better-sqlite3": "^13.0.3",
		"drizzle-orm": "^0.45.4",
		"nodemailer": "^10.2.1"
	},
	"allowScripts": {
		"better-sqlite3@13.0.3": true,
		"esbuild@0.18.20": true,
		"esbuild@0.25.12": true,
		"esbuild@0.28.2": true,
		"workerd@1.20261019.1": true,
		"fsevents@2.3.3": true
	}
}
