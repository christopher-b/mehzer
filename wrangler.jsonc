{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "mehzer",
	"main": ".svelte-kit/cloudflare/_worker.js",
	"compatibility_date": "2026-10-01",
	"compatibility_flags": ["nodejs_compat"],
	// Keep console.error lines (unexpected errors, one JSON line each) in Workers Logs
	"observability": { "enabled": true },
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "mehzer",
			"database_id": "REPLACE_WITH_D1_DATABASE_ID",
			"migrations_dir": "drizzle"
		}
	],
	"r2_buckets": [
		{
			"binding": "PHOTOS",
			"bucket_name": "mehzer-photos"
		}
	]
	// Secrets: `wrangler secret put APP_PASSWORD` and `wrangler secret put SESSION_SECRET`
}
