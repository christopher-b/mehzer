# Copy to .env. Used by `npm run dev` and by `docker compose`.

# Required
# The setup password: used once, on first start, to create the administrator account at /setup.
APP_PASSWORD=change-me
# Signs login cookies. Generate one: openssl rand -hex 32
SESSION_SECRET=generate-a-long-random-string

# Local development only (Docker keeps its data in the mehzur-data volume instead)
DATABASE_PATH=./data/mehzur.db
PHOTOS_PATH=./data/photos

# Docker Compose only (see docs/deployment.md)
# PORT=3000
# PLAIN_HTTP=true
# PROTOCOL_HEADER=
# HOST_HEADER=

# Accounts and email (optional). Invite and password-reset emails are sent through SMTP; for Proton Mail
# create an SMTP token (Settings > IMAP/SMTP) and use smtp.protonmail.ch, port 587, your address as the user.
# APP_URL is the public address used in the links in emails (no trailing slash needed).
# APP_URL=https://mehzur.example.com
# SMTP_HOST=smtp.protonmail.ch
# SMTP_PORT=587
# SMTP_USER=mehzur@example.com
# SMTP_PASSWORD=
# MAIL_FROM=Mehzur <mehzur@example.com>
# Behind a reverse proxy: ADDRESS_HEADER=x-forwarded-for
